# gRPC and metrics listeners
LISTEN_ADDR=:50051
METRICS_ADDR=:9090
# redis (distributed) or memory (single node)
BACKEND=redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=64
# Per-call budget for the Redis round-trip
REDIS_TIMEOUT=50ms
# true: allow requests when Redis is unavailable; false: return UNAVAILABLE
FAIL_OPEN=true
RULES_FILE=config/rules.yaml
